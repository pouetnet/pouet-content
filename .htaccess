# TEMPORARY: remove once prod runs the PHP security release of 2026-10-21
# (https://www.php.net/archive/2026.php#2026-10-20-1). Pouet is read-only
# until then: PHP parses request bodies (form posts, file uploads) before
# any of our code runs, so refuse them here, before they reach PHP
RewriteEngine On
RewriteCond %{REQUEST_METHOD} !^(GET|HEAD)$ [OR]
RewriteCond %{HTTP:Content-Type} multipart/ [NC]
RewriteRule ^ - [F]
<If "! (%{REQUEST_METHOD} in {'GET', 'HEAD'}) || %{HTTP:Content-Type} =~ m#multipart/#i">
  ErrorDocument 403 "pouet.net is read-only for now: we're waiting for a critical PHP security fix to be installed on our server. Posting, voting and uploading will be back soon."
</If>

<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType image/jpg "access 1 weeks"
ExpiresByType image/jpeg "access 1 weeks"
ExpiresByType image/gif "access 1 weeks"
ExpiresByType image/png "access 1 weeks"
</IfModule>

<IfModule mod_rewrite.c>

RewriteEngine On

# No directory listings (avatars/, logos/...): the server turns them on, and
# its AllowOverride refuses "Options -Indexes" here. The root included
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [F]

RewriteRule ^screenshots\/(\d+)\.([a-z]{3,4}) screenshot_legacy.php?id=$1&ext=$2 [L]

#RewriteCond %{HTTP_HOST} =pouet.net
#RewriteCond %{HTTP_HOST} =www.pouet.net
#RewriteRule ^screenshots\/(\d+)\.([a-z]{3,4}) screenshot_legacy.php?id=$1&ext=$2 [L]

</IfModule>

<FilesMatch "\.(ttf|otf|eot|woff|woff2)$">
  <IfModule mod_headers.c>
    Header set Access-Control-Allow-Origin "*"
  </IfModule>

  <IfModule mod_mime.c>
    AddType font/opentype .otf
  </IfModule>
  
</FilesMatch>

# Repo files, never served directly
RedirectMatch 404 (?i)^/README\.md$
